# ==============================================================================
# FIELD SHIFT: NASA Agricultural Decision Intelligence System
# Configuration & Dummy Environment Template
# ==============================================================================
# Copy this file to '.env' before starting the application:
# Linux / macOS:  cp .env.example .env
# Windows (CMD):  copy .env.example .env
# Windows (PS):   Copy-Item .env.example .env
# ==============================================================================

# --- Server Network Configuration ---
HOST=0.0.0.0
PORT=8000

# --- Default Farm Geospatial Coordinates ---
# Default: Delhi NCR / Indo-Gangetic Basin (IARI Pusa / Najafgarh)
DEFAULT_LAT=28.6139
DEFAULT_LON=77.2090
LOCATION_NAME=Delhi Indo-Gangetic Basin (IARI Pusa / Najafgarh)

# --- Physical RS485 Modbus Sensor Port ---
# Linux / Ubuntu default: /dev/ttyUSB0
# Windows default: COM3 or COM4 (Check Windows Device Manager -> Ports)
RS485_PORT=/dev/ttyUSB0
RS485_BAUDRATE=9600

# --- Simulated 8-in-1 IoT Telemetry Cadence ---
# When physical hardware is disconnected, backend automatically streams realistic
# Indo-Gangetic alluvial soil telemetry every N seconds:
SENSOR_SIMULATION_INTERVAL=5

# --- Optional AI Agronomist Configuration (NVIDIA NIM) ---
# NOTE: FIELD SHIFT works 100% out of the box with zero API keys required!
# NASA datasets (POWER, SMAP, GPM, MODIS, GRACE) and RainViewer Doppler radar are completely free.
# To enable advanced cloud LLM responses from NVIDIA NIM, obtain a free key at: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=google/gemma-4-31b-it
