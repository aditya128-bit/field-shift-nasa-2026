# FIELD SHIFT: NASA Agricultural Decision Intelligence System
# Configuration & Environment Variables

HOST=0.0.0.0
PORT=8000

# Default Farm Coordinates (Delhi Indo-Gangetic Basin)
DEFAULT_LAT=28.6139
DEFAULT_LON=77.2090
LOCATION_NAME=Delhi NCR (Indo-Gangetic Basin)

# NVIDIA NIM / Nemotron API Configuration
# Get your free key from: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Sensor simulation interval in seconds (for IoT telemetric stream)
SENSOR_SIMULATION_INTERVAL=5
